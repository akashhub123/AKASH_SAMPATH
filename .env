# Copy this file to .env before using docker compose.
# NEVER commit your real .env file.

MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=electricity
MYSQL_USER=akash
MYSQL_PASSWORD=akash123

# Docker Compose backend -> MySQL service
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/electricity
SPRING_DATASOURCE_USERNAME=akash
SPRING_DATASOURCE_PASSWORD=akash123

BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000
REACT_APP_BACKEND_URL=http://localhost:8080

# Google OAuth 2.0
# Get these values from Google Cloud Console.
GOOGLE_CLIENT_ID=PASTE_YOUR_GOOGLE_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=PASTE_YOUR_GOOGLE_CLIENT_SECRET_HERE

# This Google email gets ADMIN role.
# Every other Google account gets USER role.
ADMIN_EMAIL=your-google-email@gmail.com
